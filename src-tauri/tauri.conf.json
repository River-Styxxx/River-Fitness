{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "River Fitness",
  "version": "0.1.0",
  "identifier": "com.riverfitness.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "River Fitness",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#0b0e14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
